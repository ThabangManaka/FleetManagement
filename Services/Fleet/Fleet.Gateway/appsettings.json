{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
    "ReverseProxy": {
      "Routes": {
        "fleet-route": {
          "ClusterId": "fleet-api",
          "Match": {
            "Path": "{**catch-all}"
          }
        }
      },
      "Clusters": {
        "fleet-api": {
          "Destinations": {
            "fleet-api-primary": {
              "Address": "https://127.0.0.1:7114/"
            }
          }
        }
      }
    }
  }

